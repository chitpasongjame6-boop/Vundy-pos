DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority"

# Login เริ่มต้น
# เจ้าของร้านเห็นทุกเมนู / พนักงานเห็นเฉพาะขายหน้าร้าน, ประวัติบิล, ปิดยอด
OWNER_USERNAME="your-owner-username"
OWNER_PASSWORD="your-owner-password"
OWNER_APPROVAL_PIN="change-this-approval-pin"
OWNER_NAME="ເຈົ້າຂອງຮ້ານ"
STAFF_USERNAME="your-staff-username"
STAFF_PASSWORD="your-staff-password"
STAFF_NAME="ພະນັກງານຂາຍ"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Required: Cloudflare R2 object storage for product images and logos
# สร้าง R2 API token ที่มีสิทธิ์ Object Read & Write สำหรับ bucket นี้
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Public custom domain (recommended) or the public r2.dev URL; do not use the API endpoint
R2_PUBLIC_URL="https://images.example.com"
