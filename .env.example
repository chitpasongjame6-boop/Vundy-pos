DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority"

# Login เริ่มต้น
# เจ้าของร้านเห็นทุกเมนู / พนักงานเห็นเฉพาะขายหน้าร้าน, ประวัติบิล, ปิดยอด
OWNER_USERNAME="your-owner-username"
OWNER_PASSWORD="your-owner-password"
OWNER_NAME="ເຈົ້າຂອງຮ້ານ"
STAFF_USERNAME="your-staff-username"
STAFF_PASSWORD="your-staff-password"
STAFF_NAME="ພະນັກງານຂາຍ"

# Required: S3 / S3-compatible object storage for uploaded images
# ระบบ upload รูปสินค้าและโลโก้ใช้ S3 เท่านั้น
S3_BUCKET="your-bucket-name"
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"

# Optional: ใช้กับ Cloudflare R2, DigitalOcean Spaces, MinIO หรือ CDN custom domain
# S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="true"
# S3_PUBLIC_URL_PREFIX="https://cdn.example.com"
# S3_ACL="public-read"
